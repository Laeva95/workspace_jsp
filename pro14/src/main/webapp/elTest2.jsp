<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" isELIgnored="false"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<h2>el 태그 내부 산술 연산자 사용</h2>
	<!-- 
		el 태그 내부에 산술 연산자와 수식을 작성 할 수 있음
	 -->
	 
	 ${ 10 + 10 } <br>
	 ${ 20 - 10 } <br>
	 ${ 10 * 10 } <br>
	 ${ 100 div 10 } <br>
	 ${ 100 mod 9 } <br>
	
	
</body>
